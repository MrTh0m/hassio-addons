{
  "name": "OCPP Backoffice Server",
  "version": "0.1.0",
  "slug": "ocppserver",
  "description": "Serveur OCPP 1.6 (CSMS) avec API REST : plusieurs bornes, mode local ou relais par borne, comptes utilisateurs.",
  "url": "https://github.com/MrTh0m/hassio-addons",
  "arch": ["aarch64", "amd64", "armhf", "armv7", "i386"],
  "init": false,
  "startup": "application",
  "boot": "auto",
  "ingress": true,
  "ingress_port": 8000,
  "panel_icon": "mdi:server-network",
  "webui": "http://[HOST]:[PORT:8000]/docs",
  "ports": {
    "8000/tcp": 8000
  },
  "ports_description": {
    "8000/tcp": "API REST (/api, /docs) + WebSocket OCPP (/ocpp/<id_borne>)"
  },
  "options": {
    "admin_password": "changeme"
  },
  "schema": {
    "admin_password": "password"
  }
}
